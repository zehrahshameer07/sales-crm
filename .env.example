# Configuration reference. The app reads these from ENVIRONMENT VARIABLES (it does not load this file).
# Set them in your host's dashboard (e.g. Render -> Environment). NEVER commit real values; .env is git-ignored.

# ---- Required in production -------------------------------------------------------------------
# Signs login sessions. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# PostgreSQL connection string from your host (Render: "Internal Database URL").
# Leave empty locally to use a SQLite file (crm.db).
DATABASE_URL=

# ---- Optional ---------------------------------------------------------------------------------
# Business timezone used for "today", follow-ups and report dates (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
# Session length in minutes (default 480 = 8 hours)
ACCESS_TOKEN_MINUTES=480
# Failed logins before an account is locked, and for how long
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- First admin (use this on a REAL deployment) ----------------------------------------------
# Creates the first admin account when there are no users yet. Use a strong password, then change it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Demo deployments only --------------------------------------------------------------------
# true = create demo users + sample activities when the database is empty, and show the demo accounts
# on the login screen. The demo password is public, so NEVER use this for real data.
SEED_DEMO=false

# ---- One-time upgrade from version 1 ----------------------------------------------------------
# Set to true for ONE deploy to drop the old integer-ID "activities" table, then remove it again.
RESET_LEGACY_SCHEMA=false
